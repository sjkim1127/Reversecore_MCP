[run]
omit =
    # External tool — requires Ghidra JVM
    */reversecore_mcp/core/ghidra_manager.py

    # Test infrastructure
    */tests/*
    */site-packages/*

    # Radare2 integration — requires r2pipe + installed radare2 binary
    */reversecore_mcp/tools/radare2/*

    # Forensic tools — require OS-level forensic tools (Volatility, Zeek, etc.)
    */reversecore_mcp/tools/forensics/*

    # Dashboard — large Textual TUI, tested separately
    */reversecore_mcp/dashboard/*

    # Top-level server & resources — require a live FastMCP server
    */reversecore_mcp/server.py
    */reversecore_mcp/resources.py

    # Heavy ML/binary-analysis tools — require angr, capa, AFL++, pwntools, etc.
    */reversecore_mcp/tools/malware/autonomous_hunter.py
    */reversecore_mcp/tools/malware/heap_exploit.py
    */reversecore_mcp/tools/malware/poc_generator.py
    */reversecore_mcp/tools/malware/rop_builder.py
    */reversecore_mcp/tools/analysis/symbolic_analysis.py
    */reversecore_mcp/tools/analysis/taint_analysis.py
    */reversecore_mcp/tools/analysis/fuzz_tools.py
    */reversecore_mcp/tools/analysis/fuzzing_campaign.py
    */reversecore_mcp/tools/analysis/emulation_tools.py
    */reversecore_mcp/tools/analysis/crash_triage.py
    */reversecore_mcp/tools/analysis/patch_vuln_inference.py
    */reversecore_mcp/tools/analysis/source_auditor.py
    */reversecore_mcp/tools/analysis/diff_tools.py
    */reversecore_mcp/tools/analysis/static_analysis.py

    # Report generation tools — require wkhtmltopdf / LaTeX / SMTP
    */reversecore_mcp/tools/report/converter.py
    */reversecore_mcp/tools/report/email.py
    */reversecore_mcp/tools/report/sigma_generator.py
    */reversecore_mcp/tools/report/vex_generator.py

    # Stub alias modules (one-liners that re-export from common/report)
    */reversecore_mcp/tools/patch_explainer.py
    */reversecore_mcp/tools/report_tools.py

    # Heavy infra — pools, task queues, caches requiring live I/O
    */reversecore_mcp/core/r2_pool.py
    */reversecore_mcp/core/binary_cache.py
    */reversecore_mcp/core/task_queue.py
    */reversecore_mcp/core/result_cache.py
    */reversecore_mcp/core/memory.py
    */reversecore_mcp/core/loader.py
    */reversecore_mcp/core/metrics.py

    # SAST engine — filesystem scanner, tested via integration only
    */reversecore_mcp/core/sast/*

[report]
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__

    # Don't complain if tests don't hit defensive assertion code:
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run:
    if __name__ == .__main__.:
    if TYPE_CHECKING:

    # Abstract method bodies
    \.\.\.
    @(abc\.)?abstractmethod
