# =============================================================================
# Reversecore_MCP Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Most variables are optional. Features that require credentials or optional
# backends remain disabled until they are configured.

# =============================================================================
# Core Settings
# =============================================================================

# Workspace directory for analysis files.
# REVERSECORE_WORKSPACE=/path/to/workspace

# MCP transport mode: stdio (default) or http.
# MCP_TRANSPORT=stdio

# HTTP bind address and port. Keep loopback for local-only deployments.
# In Docker Compose, MCP_HOST is set to 0.0.0.0 inside the container while the
# published host port is restricted to 127.0.0.1.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Log format: human (default) or json.
# LOG_FORMAT=human

# Log level: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Temporary upload retention period in minutes (minimum: 60, default: 1440).
# FILE_RETENTION_MINUTES=1440

# Maximum upload size in bytes (default: 100 MB).
# MAX_UPLOAD_SIZE=100000000

# =============================================================================
# HTTP Mode Settings (only used when MCP_TRANSPORT=http)
# =============================================================================

# API key for authentication.
# Strongly recommended for every non-loopback deployment. The server refuses an
# unauthenticated external bind on a normal host and applies a loopback guard in
# containers, but explicit authentication is the intended remote-access model.
# MCP_API_KEY=replace-with-a-long-random-secret

# Comma-separated CORS origins. Do not use * for authenticated browser clients.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit per minute (default: 60).
# REVERSECORE_RATE_LIMIT=60

# Fail startup if HTTP rate limiting is requested but slowapi is unavailable.
# REVERSECORE_RATE_LIMIT_STRICT=true

# =============================================================================
# File Access and Analysis Limits
# =============================================================================

# Additional comma-separated read-only directories outside the workspace.
# REVERSECORE_READ_DIRS=/opt/rules,/mnt/reference-binaries

# Default tool timeout in seconds (default: 120).
# REVERSECORE_DEFAULT_TOOL_TIMEOUT=120

# Maximum number of ESIL emulation instructions (default: 1000).
# MAX_EMULATION_INSTRUCTIONS=1000

# =============================================================================
# Radare2 Pool Settings
# =============================================================================

# Connection pool size (default: 3).
# REVERSECORE_R2_POOL_SIZE=3

# Connection acquisition timeout in seconds (default: 30).
# REVERSECORE_R2_POOL_TIMEOUT=30

# Maximum number of persistent file-backed Radare2 sessions (default: 8).
# REVERSECORE_R2_SESSION_MAX=8

# Close idle Radare2 sessions after this many seconds (default: 900).
# REVERSECORE_R2_SESSION_IDLE_TTL=900

# =============================================================================
# Redis / Background Jobs
# =============================================================================

# Redis URL for the task queue and result cache.
# Docker Compose supplies redis://redis:6379/0 automatically.
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Sandbox Settings
# =============================================================================

# Enable sandbox execution for supported dynamic/external analysis paths.
# Review the sandbox documentation and image requirements before enabling this
# on a host installation.
# REVERSECORE_SANDBOX_ENABLED=false
# REVERSECORE_SANDBOX_MODE=auto
# REVERSECORE_SANDBOX_DOCKER_IMAGE=reversecore-sandbox:latest
# REVERSECORE_SANDBOX_CPU_LIMIT=1.0
# REVERSECORE_SANDBOX_MEMORY_LIMIT=512m
# REVERSECORE_SANDBOX_PIDS_LIMIT=100
# REVERSECORE_SANDBOX_USER=nobody

# =============================================================================
# Database Settings
# =============================================================================

# Path to the SQLite DB for persisting annotations/structures.
# R2GHIDRA_DB_PATH=/path/to/database.db

# AI memory database path.
# MEMORY_DB_PATH=~/.reversecore_mcp/memory.db

# =============================================================================
# Report Email Settings (for send_report_email tool)
# =============================================================================
# Leave credentials empty to disable email delivery.

# SMTP server address (e.g., smtp.gmail.com, smtp.naver.com).
REPORT_SMTP_SERVER=

# SMTP port (default: 587 for TLS, 465 for SSL).
REPORT_SMTP_PORT=587

# Email account username.
REPORT_SMTP_USERNAME=

# Email account password or app-specific password.
# For Gmail: use an App Password with 2FA enabled.
# For Naver: enable POP3/SMTP and use an app password.
REPORT_SMTP_PASSWORD=

# Use TLS encryption (default: true).
REPORT_SMTP_USE_TLS=true

# Default sender name (optional).
REPORT_SENDER_NAME=Reversecore_MCP

# =============================================================================
# Quick Contacts (comma-separated, format: name:email:role)
# =============================================================================
# Example: REPORT_QUICK_CONTACTS=SOC Lead:soc@company.com:Manager,CISO:ciso@company.com:Executive

REPORT_QUICK_CONTACTS=

# =============================================================================
# Report Settings
# =============================================================================

# Default timezone for reports.
REPORT_DEFAULT_TIMEZONE=Asia/Seoul

# Default TLP classification.
# Options: TLP:WHITE, TLP:GREEN, TLP:AMBER, TLP:RED
REPORT_DEFAULT_CLASSIFICATION=TLP:AMBER

# Default analyst name.
REPORT_DEFAULT_ANALYST=Security Researcher

# =============================================================================
# Threat Intelligence
# =============================================================================

# VirusTotal API v3 key — required for vt_lookup tool.
# Get a free key at: https://www.virustotal.com/gui/user/apikey
# Free tier: 4 requests/minute, 500 requests/day.
REVERSECORE_VT_API_KEY=

# Timeout for VirusTotal API requests in seconds (default: 30).
REVERSECORE_VT_TIMEOUT=30
