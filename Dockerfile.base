# Reversecore_MCP — Base Image
#
# Contains all slow-to-build, rarely-changing dependencies:
#   - YARA (compiled from source to match yara-python binding)
#   - radare2 (compiled from source for Debian bookworm compatibility)
#   - r2ghidra plugin (embeds Ghidra decompiler engine inside radare2 — no JDK/Ghidra install needed)
#   - Python venv with all pinned requirements
#
# This image is rebuilt ONLY when tool versions change (ARG values below).
# The main Dockerfile simply does `FROM ghcr.io/.../base:TAG` and copies
# application code — cutting cold-build time from ~12min to ~60s.
#
# Rebuild trigger: bump any of the ARG version values and push to main.
# The `build-base-image` GitHub Actions job detects changes to this file.

# ============================================================================
# Stage 1: Compile stage (contains build toolchain)
# ============================================================================
FROM python:3.12-slim-bookworm AS compiler
ARG TARGETARCH
ARG YARA_VERSION=4.3.1
ARG RADARE2_VERSION=6.0.4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /app

# hadolint ignore=DL3008
# Build toolchain — NOT copied to final base image
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    cmake \
    automake \
    autoconf \
    libtool \
    pkg-config \
    flex \
    bison \
    libssl-dev \
    zlib1g-dev \
    libffi-dev \
    git \
    patch \
    xz-utils \
    curl \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# ── YARA ─────────────────────────────────────────────────────────────────────
# Build from source so the native library exactly matches the yara-python wheel
RUN curl -sSL "https://github.com/VirusTotal/yara/archive/refs/tags/v${YARA_VERSION}.tar.gz" \
        -o /tmp/yara.tar.gz \
    && tar -xzf /tmp/yara.tar.gz -C /tmp
WORKDIR /tmp/yara-${YARA_VERSION}
RUN ./bootstrap.sh \
    && ./configure --disable-cuckoo --disable-magic --disable-dotnet \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig
WORKDIR /app
RUN rm -rf /tmp/yara*

# ── radare2 ──────────────────────────────────────────────────────────────────
# Build from source (not in Debian bookworm main repo)
RUN git clone --depth 1 --branch ${RADARE2_VERSION} \
        https://github.com/radareorg/radare2.git /tmp/radare2
WORKDIR /tmp/radare2
RUN ./configure --prefix=/opt/radare2 \
    && make -j"$(nproc)" \
    && make install \
    && echo "/opt/radare2/lib" > /etc/ld.so.conf.d/radare2.conf \
    && ldconfig
WORKDIR /app
RUN rm -rf /tmp/radare2

# ── r2ghidra plugin ────────────────────────────────────────────
# Build from source against the EXACT radare2 version installed above.
ENV PATH="/opt/radare2/bin:$PATH"
ARG R2GHIDRA_VERSION=6.0.4
RUN git clone --depth 1 --branch ${R2GHIDRA_VERSION} \
        https://github.com/radareorg/r2ghidra.git /tmp/r2ghidra \
    && cd /tmp/r2ghidra \
    && sed -i 's/VPATH=.dirname.*/VPATH=./' configure \
    && PKG_CONFIG_PATH="/opt/radare2/lib/pkgconfig" ./configure --prefix=/opt/radare2 \
    && make -C subprojects \
    && make -j2 \
    && make install \
    && rm -rf /tmp/r2ghidra


# ── Python venv + dependencies ───────────────────────────────────────────────
COPY requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Use pip cache mount for faster rebuilds when requirements.txt changes
# hadolint ignore=DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt \
    && pip install volatility3>=2.4.0 scapy>=2.5.0

# ============================================================================
# Stage 2: Final base image (no build toolchain, runtime-only)
# ============================================================================
FROM python:3.12-slim-bookworm AS base
ARG TARGETARCH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /app

# Create workspace and rules directories
RUN mkdir -p /app/workspace /app/rules

# hadolint ignore=DL3008
# Runtime system packages only (no compiler, no build tools)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    # coreutils "file" command required by run_file tool
    file \
    # Binutils (strings, objdump, nm, etc.)
    binutils \
    # GNU Debugger for crash triage
    gdb \
    # Firmware analysis and file carving
    binwalk \
    # CFG image generation (FastMCP Image support)
    graphviz \
    # Assembler required by assemble_instructions tool
    nasm \
    # For downloading JDK tarball at image build time
    curl \
    gnupg \
    # Disk forensics: Sleuth Kit CLI (fls, mmls, icat, istat, ffind, fsstat)
    sleuthkit \
    && rm -rf /var/lib/apt/lists/*

# ── Copy compiled artifacts from compiler stage ───────────────────────────────
RUN mkdir -p /usr/local/include /usr/local/lib/pkgconfig
COPY --from=compiler /usr/local/bin/yara     /usr/local/bin/yara
COPY --from=compiler /usr/local/bin/yarac    /usr/local/bin/yarac
COPY --from=compiler /usr/local/lib/libyara* /usr/local/lib/
COPY --from=compiler /usr/local/include/yara /usr/local/include/yara
COPY --from=compiler /usr/local/lib/pkgconfig/yara.pc /usr/local/lib/pkgconfig/yara.pc
COPY --from=compiler /opt/radare2            /opt/radare2
# r2ghidra plugin is installed into /opt/radare2 by cmake —
# it is already included in the COPY --from=compiler /opt/radare2 line above.

COPY --from=compiler /opt/venv               /opt/venv


# Ensure radare2 shared libs are discovered by the dynamic linker
RUN echo "/opt/radare2/lib" > /etc/ld.so.conf.d/radare2.conf && ldconfig

# ── Environment ──────────────────────────────────────────────────────────────
ENV PATH="/opt/radare2/bin:/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    REVERSECORE_WORKSPACE=/app/workspace \
    MCP_TRANSPORT=http \
    LOG_LEVEL=INFO \
    LOG_FILE=/var/log/reversecore/app.log \
    MEMORY_DB_PATH=/app/workspace/.memory.db \
    R2GHIDRA_DB_PATH=/app/workspace/.r2db \
    RATE_LIMIT=60

# Create log directory and non-root user
RUN mkdir -p /var/log/reversecore \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app /var/log/reversecore

# Note: No CMD / ENTRYPOINT here.
# App image inherits from this base and adds application code.
